rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function contentAdmin() { return signedIn() && request.auth.token.keys().hasAll(['contentAdmin']) && request.auth.token.contentAdmin == true; }
    function opsAdmin() { return signedIn() && request.auth.token.keys().hasAll(['opsAdmin']) && request.auth.token.opsAdmin == true; }
    function trustedServer() { return signedIn() && request.auth.token.keys().hasAll(['server']) && request.auth.token.server == true; }
    function validOperationKey(value) { return value is string && value.size() >= 8 && value.size() <= 128 && value.matches('^[A-Za-z0-9_-]+$'); }
    function validDate(value) { return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function validTime(value) { return value is string && value.matches('^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$'); }
    function validInstant(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$'); }
    function allowedUserCollection(collection) {
      return collection in ['personalPlants', 'wateringRecords', 'wateringSchedules', 'notificationSettings', 'weatherSnapshots', 'weatherRisks', 'miniHomes', 'placements', 'ownedItems', 'shareLinks', 'consents', 'deletionRequests', 'notificationDeliveries', 'identificationRequests'];
    }
    function validCollectionData(collection) {
      return (collection != 'wateringSchedules' || (validDate(request.resource.data.dueDate) && validTime(request.resource.data.reminderTime) && request.resource.data.zoneId is string))
        && (collection != 'wateringRecords' || validDate(request.resource.data.wateredDate))
        && (collection != 'notificationSettings' || (validTime(request.resource.data.defaultTime) && request.resource.data.zoneId is string))
        && (collection != 'personalPlants' || !request.resource.data.keys().hasAny(['lastWateredDate']) || request.resource.data.lastWateredDate == null || validDate(request.resource.data.lastWateredDate));
    }
    function validCreate(uid) {
      return request.resource.data.ownerUid == uid
        && request.resource.data.revision is int
        && request.resource.data.revision == 1
        && request.resource.data.expectedRevision is int
        && request.resource.data.expectedRevision == 0
        && validOperationKey(request.resource.data.idempotencyKey)
        && validInstant(request.resource.data.updatedAt);
    }
    function validUpdate(uid) {
      return resource.data.ownerUid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.revision is int
        && request.resource.data.expectedRevision is int
        && request.resource.data.expectedRevision == resource.data.revision
        && request.resource.data.revision == resource.data.revision + 1
        && validOperationKey(request.resource.data.idempotencyKey)
        && validInstant(request.resource.data.updatedAt);
    }
    function validPublishedContent() {
      return request.resource.data.publicationState in ['DRAFT', 'PUBLIC', 'PRIVATE']
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }
    function publicDocument() { return resource.data.publicationState == 'PUBLIC'; }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validCreate(uid);
      allow update: if owns(uid) && validUpdate(uid);
      allow delete: if owns(uid) && resource.data.ownerUid == uid;
    }

    match /users/{uid}/operations/{operationId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && operationId == request.resource.data.idempotencyKey && validCreate(uid);
      allow update, delete: if false;
    }

    match /users/{uid}/{collection}/{documentId} {
      allow read: if allowedUserCollection(collection) && owns(uid);
      allow create: if allowedUserCollection(collection) && owns(uid) && validCreate(uid) && validCollectionData(collection);
      allow update: if allowedUserCollection(collection) && owns(uid) && validUpdate(uid) && validCollectionData(collection);
      allow delete: if allowedUserCollection(collection) && owns(uid) && resource.data.ownerUid == uid;
    }

    match /plantContents/{documentId} {
      allow read: if contentAdmin() || publicDocument();
      allow create, update: if contentAdmin() && validPublishedContent();
      allow delete: if contentAdmin();
    }
    match /riskContents/{documentId} {
      allow read: if contentAdmin() || publicDocument();
      allow create, update: if contentAdmin() && validPublishedContent();
      allow delete: if contentAdmin();
    }
    match /shopItems/{documentId} {
      allow read: if contentAdmin() || publicDocument();
      allow create, update: if contentAdmin() && validPublishedContent();
      allow delete: if contentAdmin();
    }
    match /publicShares/{documentId} {
      allow read: if publicDocument() && resource.data.revokedAt == null && request.time < resource.data.expiresAt;
      allow write: if trustedServer();
    }
    match /auditLogs/{documentId} {
      allow read: if opsAdmin();
      allow create: if trustedServer();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
