rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function claim(name) { return signedIn() && request.auth.token.keys().hasAll([name]) && request.auth.token[name] == true; }
    function contentAdmin() { return claim('contentAdmin'); }
    function opsAdmin() { return claim('opsAdmin'); }
    function trustedServer() { return claim('server'); }
    function validOpaqueId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function validOperationKey(value) { return value is string && value.size() >= 8 && value.size() <= 128 && value.matches('^[A-Za-z0-9_-]+$'); }
    function leapYear(year) { return year % 400 == 0 || (year % 4 == 0 && year % 100 != 0); }
    function daysInMonth(year, month) {
      return month == 2 ? (leapYear(year) ? 29 : 28) : ((month == 4 || month == 6 || month == 9 || month == 11) ? 30 : 31);
    }
    function validDate(value) {
      let parts = value is string ? value.split('-') : [];
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(parts[2]) <= daysInMonth(int(parts[0]), int(parts[1]));
    }
    function validTime(value) { return value is string && value.matches('^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$'); }
    function validInstant(value) {
      let parts = value is string ? value.split('T') : [];
      return value is string && parts.size() == 2 && validDate(parts[0]) && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,9})?Z$');
    }
    function metadataFields() { return ['ownerUid', 'revision', 'expectedRevision', 'idempotencyKey', 'updatedAt']; }
    function validEntityKeys(required, optional) {
      return request.resource.data.keys().hasAll(metadataFields().concat(required))
        && request.resource.data.keys().hasOnly(metadataFields().concat(required).concat(optional));
    }
    function validUpdatedAt(value) { return value is timestamp || validInstant(value); }
    function validMetadata(uid) {
      return request.resource.data.ownerUid == uid
        && request.resource.data.revision is int
        && request.resource.data.expectedRevision is int
        && validOperationKey(request.resource.data.idempotencyKey)
        && validUpdatedAt(request.resource.data.updatedAt);
    }
    function validCreate(uid) { return validMetadata(uid) && request.resource.data.revision == 1 && request.resource.data.expectedRevision == 0; }
    function validUpdate(uid) {
      return validMetadata(uid)
        && resource.data.ownerUid == uid
        && request.resource.data.expectedRevision == resource.data.revision
        && request.resource.data.revision == resource.data.revision + 1;
    }
    function approvedCollection(collection) {
      return collection in ['personalPlants', 'wateringRecords', 'wateringSchedules', 'notificationSettings', 'notificationPlantSettings', 'weatherSettings', 'weatherPlantSettings', 'weatherSnapshots', 'weatherRisks', 'miniHomes', 'miniHomeStates', 'placements', 'ownedItems', 'consents', 'deletionRequests', 'notificationDeliveries', 'notificationHistory', 'identificationRequests'];
    }
    function ownerWritable(collection) {
      return collection in ['consents', 'identificationRequests'];
    }
    function serverWritable(collection) {
      return collection in ['wateringRecords', 'wateringSchedules', 'notificationSettings', 'notificationPlantSettings', 'weatherSettings', 'weatherPlantSettings', 'weatherSnapshots', 'weatherRisks', 'miniHomes', 'miniHomeStates', 'placements', 'ownedItems', 'deletionRequests', 'notificationDeliveries', 'notificationHistory'];
    }
    function validPersonalPlant() {
      return validEntityKeys(['displayName', 'registrationMethod'], ['contentId', 'representativePhotoPath', 'location', 'note', 'lastWateredDate'])
        && request.resource.data.displayName is string
        && request.resource.data.registrationMethod in ['IDENTIFIED', 'IDENTIFICATION_EDITED', 'MANUAL']
        && (!request.resource.data.keys().hasAny(['lastWateredDate']) || request.resource.data.lastWateredDate == null || validDate(request.resource.data.lastWateredDate));
    }
    function validOwnerEntity(collection) {
      return (collection == 'personalPlants' && validPersonalPlant())
        || (collection == 'wateringRecords'
          && validEntityKeys(['plantId', 'wateredDate', 'recordedAt'], [])
          && validOpaqueId(request.resource.data.plantId) && validDate(request.resource.data.wateredDate) && request.resource.data.recordedAt is timestamp)
        || (collection == 'wateringSchedules'
          && validEntityKeys(['plantId', 'dueDate', 'zoneId'], ['notificationCandidateActive', 'nextNotificationAt'])
          && validOpaqueId(request.resource.data.plantId) && validDate(request.resource.data.dueDate) && request.resource.data.zoneId is string
          && (!request.resource.data.keys().hasAny(['notificationCandidateActive']) || request.resource.data.notificationCandidateActive is bool)
          && (!request.resource.data.keys().hasAny(['nextNotificationAt']) || request.resource.data.nextNotificationAt is timestamp)
          && (!request.resource.data.keys().hasAny(['nextNotificationAt']) || request.resource.data.notificationCandidateActive == true))
        || (collection == 'notificationSettings'
          && validEntityKeys(['wateringEnabled', 'weatherEnabled', 'defaultTime', 'zoneId'], [])
          && request.resource.data.wateringEnabled is bool && request.resource.data.weatherEnabled is bool && validTime(request.resource.data.defaultTime) && request.resource.data.zoneId is string)
        || (collection == 'notificationPlantSettings'
          && validEntityKeys(['plantId', 'enabled', 'timeOverride'], [])
          && validOpaqueId(request.resource.data.plantId)
          && request.resource.data.enabled is bool
          && (request.resource.data.timeOverride == null || validTime(request.resource.data.timeOverride)))
        || (collection == 'weatherSettings'
          && validEntityKeys(['globalAlertsEnabled'], ['manualRegion', 'deviceRegion', 'lastRefreshAt'])
          && request.resource.data.globalAlertsEnabled is bool
          && (!request.resource.data.keys().hasAny(['manualRegion']) || request.resource.data.manualRegion is map)
          && (!request.resource.data.keys().hasAny(['deviceRegion']) || request.resource.data.deviceRegion is map)
          && (!request.resource.data.keys().hasAny(['lastRefreshAt']) || request.resource.data.lastRefreshAt is timestamp))
        || (collection == 'weatherPlantSettings'
          && validEntityKeys(['plantId', 'enabled'], [])
          && validOpaqueId(request.resource.data.plantId) && request.resource.data.enabled is bool)
        || (collection == 'miniHomes'
          && validEntityKeys(['name', 'placedPlantCount', 'placementCount', 'placementIds', 'requestHash'], [])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
          && request.resource.data.requestHash is string && request.resource.data.requestHash.matches('^[a-f0-9]{64}$')
          && request.resource.data.placedPlantCount is int && request.resource.data.placedPlantCount >= 0 && request.resource.data.placedPlantCount <= 20
          && request.resource.data.placementCount is int && request.resource.data.placementCount >= 0 && request.resource.data.placementCount <= 20
          && request.resource.data.placementIds is list && request.resource.data.placementIds.size() == request.resource.data.placementCount)
        || (collection == 'miniHomeStates'
          && validEntityKeys(['state', 'miniHomeId', 'layoutRevision', 'requestHash', 'tombstoneId'], [])
          && request.resource.data.state in ['ACTIVE', 'DELETED']
          && ((request.resource.data.state == 'ACTIVE'
              && validOpaqueId(request.resource.data.miniHomeId)
              && request.resource.data.layoutRevision is int && request.resource.data.layoutRevision >= 1
              && request.resource.data.requestHash is string && request.resource.data.requestHash.matches('^[a-f0-9]{64}$')
              && request.resource.data.tombstoneId == null)
            || (request.resource.data.state == 'DELETED'
              && request.resource.data.miniHomeId == null
              && request.resource.data.layoutRevision == null
              && request.resource.data.requestHash == null
              && validOperationKey(request.resource.data.tombstoneId)
              && request.resource.data.idempotencyKey == request.resource.data.tombstoneId)))
        || (collection == 'placements'
          && validEntityKeys(['miniHomeId', 'layoutRevision', 'plantId', 'itemId', 'normalizedX', 'normalizedY', 'zIndex'], [])
          && validOpaqueId(request.resource.data.miniHomeId)
          && request.resource.data.layoutRevision is int && request.resource.data.layoutRevision >= 1
          && ((validOpaqueId(request.resource.data.plantId) && request.resource.data.itemId == null)
            || (request.resource.data.plantId == null && validOpaqueId(request.resource.data.itemId)))
          && request.resource.data.normalizedX is number && request.resource.data.normalizedX >= 0 && request.resource.data.normalizedX <= 1
          && request.resource.data.normalizedY is number && request.resource.data.normalizedY >= 0 && request.resource.data.normalizedY <= 1
          && request.resource.data.zIndex is int && request.resource.data.zIndex >= 0 && request.resource.data.zIndex < 20)
        || (collection == 'consents'
          && validEntityKeys(['type', 'granted', 'recordedAt'], ['commandGeneration', 'legacyRecovery'])
          && request.resource.data.type in ['IDENTIFICATION_PHOTO_PROCESSING', 'LOCATION', 'ANALYTICS']
          && request.resource.data.granted is bool && request.resource.data.recordedAt is timestamp
          && (!request.resource.data.keys().hasAny(['commandGeneration']) || (request.resource.data.commandGeneration is int && request.resource.data.commandGeneration >= 1 && request.resource.data.commandGeneration <= 9007199254740991))
          && (!request.resource.data.keys().hasAny(['legacyRecovery']) || (request.resource.data.legacyRecovery is bool && request.resource.data.type == 'LOCATION')))
        || (collection == 'identificationRequests'
          && validEntityKeys(['temporaryOriginalPath', 'createdAt', 'expiresAt'], [])
          && request.resource.data.temporaryOriginalPath is string && request.resource.data.createdAt is timestamp
          && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.resource.data.createdAt);
    }
    function validPlacementMetadata(uid) {
      return validMetadata(uid)
        && request.resource.data.revision == request.resource.data.layoutRevision
        && request.resource.data.expectedRevision == request.resource.data.layoutRevision - 1;
    }
    function validDelivery() {
      return validEntityKeys(['plantId', 'dueDate', 'attempt', 'status', 'scheduledFor', 'deliveredAt', 'deduplicationKey'], [])
        && validOpaqueId(request.resource.data.plantId)
        && validDate(request.resource.data.dueDate)
        && request.resource.data.attempt in [0, 1]
        && request.resource.data.status == 'SENT'
        && request.resource.data.scheduledFor is timestamp
        && (request.resource.data.deliveredAt == null || request.resource.data.deliveredAt is timestamp)
        && request.resource.data.deduplicationKey is string
        && request.resource.data.deliveredAt is timestamp
        && (request.resource.data.deliveredAt == null || request.resource.data.deliveredAt >= request.resource.data.scheduledFor);
    }
    function validNotificationHistory() {
      return validEntityKeys(
          ['plantId', 'dueDate', 'attempt', 'status', 'destinationOpened', 'deduplicationKey'],
          ['deliveryConfirmedAt', 'failedAt', 'failureKind', 'ambiguousAt', 'openedAt'])
        && validOpaqueId(request.resource.data.plantId)
        && validDate(request.resource.data.dueDate)
        && request.resource.data.attempt in [0, 1]
        && request.resource.data.status in ['SENT', 'FAILED', 'DELIVERED_AMBIGUOUS']
        && request.resource.data.destinationOpened is bool
        && request.resource.data.deduplicationKey is string
        && (!request.resource.data.keys().hasAny(['deliveryConfirmedAt']) || request.resource.data.deliveryConfirmedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['failedAt']) || request.resource.data.failedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['openedAt']) || request.resource.data.openedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['ambiguousAt']) || request.resource.data.ambiguousAt is timestamp)
        && (request.resource.data.status != 'SENT' || request.resource.data.deliveryConfirmedAt is timestamp)
        && (request.resource.data.status != 'DELIVERED_AMBIGUOUS' || (request.resource.data.deliveryConfirmedAt is timestamp && request.resource.data.ambiguousAt is timestamp))
        && (request.resource.data.status != 'FAILED' || request.resource.data.failedAt is timestamp)
        && (!request.resource.data.destinationOpened || request.resource.data.openedAt is timestamp);
    }
    function validDeletion() {
      return validEntityKeys(['status', 'requestedAt', 'scheduledFor', 'completedAt'], [])
        && request.resource.data.status in ['RECEIVED', 'PROCESSING', 'COMPLETED', 'FAILED', 'PARTIALLY_FAILED', 'CANCELLED']
        && request.resource.data.requestedAt is timestamp && request.resource.data.scheduledFor is timestamp
        && request.resource.data.scheduledFor >= request.resource.data.requestedAt
        && (request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp)
        && (request.resource.data.completedAt == null || request.resource.data.completedAt >= request.resource.data.scheduledFor)
        && (request.resource.data.status != 'COMPLETED' || request.resource.data.completedAt is timestamp);
    }
    function validServerEntity(collection) {
      return (collection == 'notificationDeliveries' && validDelivery())
        || (collection == 'notificationHistory' && validNotificationHistory())
        || (collection == 'weatherSnapshots'
          && validEntityKeys(['regionCode', 'regionName', 'temperatureCelsius', 'humidityPercent', 'precipitationMillimeters', 'observedAt', 'expiresAt', 'zoneId', 'stale', 'unavailablePlantIds'], [])
          && request.resource.data.regionCode is string && request.resource.data.regionName is string
          && request.resource.data.temperatureCelsius is number
          && request.resource.data.humidityPercent is int && request.resource.data.humidityPercent >= 0 && request.resource.data.humidityPercent <= 100
          && request.resource.data.precipitationMillimeters is number && request.resource.data.precipitationMillimeters >= 0
          && request.resource.data.observedAt is timestamp && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.resource.data.observedAt
          && request.resource.data.zoneId is string && request.resource.data.stale is bool
          && request.resource.data.unavailablePlantIds is list
          && request.resource.data.unavailablePlantIds.size() <= 200)
        || (collection == 'weatherRisks'
          && validEntityKeys(['plantId', 'plantName', 'snapshotId', 'type', 'reason', 'detectedAt', 'observedAt', 'active', 'transition', 'deliveredTransition'], ['action'])
          && validOpaqueId(request.resource.data.plantId) && validOpaqueId(request.resource.data.snapshotId)
          && request.resource.data.plantName is string && request.resource.data.reason is string
          && request.resource.data.type in ['HIGH_TEMPERATURE', 'LOW_TEMPERATURE', 'DRY', 'OVERHUMID']
          && request.resource.data.detectedAt is timestamp && request.resource.data.observedAt is timestamp
          && request.resource.data.active is bool && request.resource.data.transition is int && request.resource.data.transition >= 0
          && (request.resource.data.deliveredTransition == null || request.resource.data.deliveredTransition is int))
        || (collection == 'deletionRequests' && validDeletion())
        || (collection == 'ownedItems'
          && validEntityKeys(
            ['itemId', 'acquiredAt', 'applied'],
            ['nameSnapshot', 'categorySnapshot', 'assetPathSnapshot', 'assetSha256Snapshot',
              'assetByteSizeSnapshot', 'assetMimeTypeSnapshot', 'assetWidthSnapshot',
              'assetHeightSnapshot', 'assetMediaRevisionSnapshot', 'catalogRevisionSnapshot']
          )
          && validOpaqueId(request.resource.data.itemId)
          && request.resource.data.acquiredAt is timestamp
          && request.resource.data.applied is bool
          && (
            !request.resource.data.keys().hasAny([
              'nameSnapshot', 'categorySnapshot', 'assetPathSnapshot', 'assetSha256Snapshot',
              'assetByteSizeSnapshot', 'assetMimeTypeSnapshot', 'assetWidthSnapshot',
              'assetHeightSnapshot', 'assetMediaRevisionSnapshot', 'catalogRevisionSnapshot'
            ])
            || (
              request.resource.data.keys().hasAll([
                'nameSnapshot', 'categorySnapshot', 'assetPathSnapshot', 'assetSha256Snapshot',
                'assetByteSizeSnapshot', 'assetMimeTypeSnapshot', 'assetWidthSnapshot',
                'assetHeightSnapshot', 'assetMediaRevisionSnapshot', 'catalogRevisionSnapshot'
              ])
              && request.resource.data.nameSnapshot is string
              && request.resource.data.nameSnapshot.size() >= 1
              && request.resource.data.nameSnapshot.size() <= 100
              && request.resource.data.categorySnapshot in ['BACKGROUND', 'FURNITURE', 'DECORATION']
              && validCatalogAssetPath(
                request.resource.data.itemId,
                request.resource.data.assetPathSnapshot,
                request.resource.data.assetSha256Snapshot
              )
              && validCatalogSnapshotMedia()
              && request.resource.data.catalogRevisionSnapshot is int
              && request.resource.data.catalogRevisionSnapshot >= 1
            )
          ))
        ;
    }
    function validPublishedContent() {
      return request.resource.data.publicationState in ['DRAFT', 'PUBLIC', 'PRIVATE']
        && request.resource.data.revision is int && request.resource.data.revision >= 1
        && (!request.resource.data.keys().hasAny(['wateringIntervalDays'])
          || (request.resource.data.wateringIntervalDays is int
            && request.resource.data.wateringIntervalDays >= 1
            && request.resource.data.wateringIntervalDays <= 365));
    }
    function validCatalogAssetPath(itemId, assetPath, sha256) {
      return validOpaqueId(itemId)
        && sha256 is string
        && sha256.matches('^[a-f0-9]{64}$')
        && assetPath is string
        && assetPath.size() >= 1
        && assetPath.size() <= 512
        && assetPath.matches('^catalog-assets/' + itemId + '/' + sha256 + '[.](png|jpg|jpeg|webp)$');
    }
    function validCatalogMediaBounds(byteSize, width, height) {
      return byteSize is int && byteSize >= 1 && byteSize <= 8 * 1024 * 1024
        && width is int && width >= 1 && width <= 32768
        && height is int && height >= 1 && height <= 32768
        && width * height <= 64 * 1024 * 1024
        && width * height * 4 <= 256 * 1024 * 1024
        && width <= height * 32 && height <= width * 32;
    }
    function validCatalogSnapshotMedia() {
      return request.resource.data.assetMimeTypeSnapshot in ['image/png', 'image/jpeg', 'image/webp']
        && ((request.resource.data.assetPathSnapshot.matches('.*[.]png$') && request.resource.data.assetMimeTypeSnapshot == 'image/png')
          || (request.resource.data.assetPathSnapshot.matches('.*[.](jpg|jpeg)$') && request.resource.data.assetMimeTypeSnapshot == 'image/jpeg')
          || (request.resource.data.assetPathSnapshot.matches('.*[.]webp$') && request.resource.data.assetMimeTypeSnapshot == 'image/webp'))
        && request.resource.data.assetMediaRevisionSnapshot is int
        && request.resource.data.assetMediaRevisionSnapshot >= 1
        && validCatalogMediaBounds(
          request.resource.data.assetByteSizeSnapshot,
          request.resource.data.assetWidthSnapshot,
          request.resource.data.assetHeightSnapshot
        );
    }
    function validCatalogMediaMetadata(assetPath) {
      return request.resource.data.assetContentType in ['image/png', 'image/jpeg', 'image/webp']
        && ((assetPath.matches('.*[.]png$') && request.resource.data.assetContentType == 'image/png')
          || (assetPath.matches('.*[.](jpg|jpeg)$') && request.resource.data.assetContentType == 'image/jpeg')
          || (assetPath.matches('.*[.]webp$') && request.resource.data.assetContentType == 'image/webp'))
        && request.resource.data.assetMediaRevision is int
        && request.resource.data.assetMediaRevision >= 1
        && validCatalogMediaBounds(
          request.resource.data.assetByteSize,
          request.resource.data.assetWidth,
          request.resource.data.assetHeight
        );
    }
    function validShopItem(documentId) {
      return request.resource.data.keys().hasAll([
          'name', 'description', 'category', 'assetPath', 'assetSha256', 'assetContentType',
          'assetByteSize', 'assetWidth', 'assetHeight', 'assetMediaRevision', 'acquisitionCondition',
          'publicationState', 'revision', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'category', 'assetPath', 'assetSha256', 'assetContentType',
          'assetByteSize', 'assetWidth', 'assetHeight', 'assetMediaRevision', 'acquisitionCondition',
          'publicationState', 'revision', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1 && request.resource.data.description.size() <= 500
        && request.resource.data.category in ['BACKGROUND', 'FURNITURE', 'DECORATION']
        && validCatalogAssetPath(documentId, request.resource.data.assetPath, request.resource.data.assetSha256)
        && validCatalogMediaMetadata(request.resource.data.assetPath)
        && request.resource.data.acquisitionCondition in [null, 'registered-plant']
        && request.resource.data.updatedAt is timestamp
        && validPublishedContent();
    }
    function sameCatalogMediaIdentity() {
      return request.resource.data.assetPath == resource.data.assetPath
        && request.resource.data.assetSha256 == resource.data.assetSha256
        && request.resource.data.assetContentType == resource.data.assetContentType
        && request.resource.data.assetByteSize == resource.data.assetByteSize
        && request.resource.data.assetWidth == resource.data.assetWidth
        && request.resource.data.assetHeight == resource.data.assetHeight
        && request.resource.data.assetMediaRevision == resource.data.assetMediaRevision;
    }
    function validCatalogMediaVersionUpdate() {
      return sameCatalogMediaIdentity()
        || (request.resource.data.assetPath != resource.data.assetPath
          && request.resource.data.assetSha256 != resource.data.assetSha256
          && request.resource.data.assetMediaRevision == resource.data.assetMediaRevision + 1);
    }
    function validOperationMetadata(uid, operationId) {
      return request.resource.data.ownerUid == uid
        && request.resource.data.idempotencyKey == operationId
        && validOperationKey(request.resource.data.idempotencyKey)
        && request.resource.data.documentPath is string
        && request.resource.data.requestHash is string
        && request.resource.data.requestHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.expectedRevision is int
        && request.resource.data.expectedRevision >= 0
        && request.resource.data.revision == request.resource.data.expectedRevision + 1
        && validUpdatedAt(request.resource.data.updatedAt);
    }
    function validGenericOperation(uid, operationId) {
      return request.resource.data.keys().hasOnly(metadataFields().concat(['documentPath', 'requestHash']))
        && validOperationMetadata(uid, operationId);
    }
    function validWateringOperation(uid, operationId) {
      return request.resource.data.keys().hasOnly(metadataFields().concat([
          'documentPath', 'requestHash', 'wateredDate', 'dueDate', 'recordId',
          'plantRevision', 'scheduleRevision', 'recordedAt', 'zoneId'
        ]))
        && validOperationMetadata(uid, operationId)
        && request.resource.data.recordId == operationId
        && validDate(request.resource.data.wateredDate)
        && validDate(request.resource.data.dueDate)
        && request.resource.data.dueDate > request.resource.data.wateredDate
        && request.resource.data.plantRevision == request.resource.data.revision
        && request.resource.data.scheduleRevision is int
        && request.resource.data.scheduleRevision >= 1
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.zoneId is string;
    }
    function publicDocument() { return resource.data.publicationState == 'PUBLIC'; }
    match /appleAuthSessions/{sessionId} {
      allow read, write: if false;
    }
    match /appleAuthRateLimits/{rateKey} {
      allow read, write: if false;
    }
    match /notificationDeliveryClaims/{claimId} {
      allow read, write: if false;
    }
    match /notificationRuntime/{runtimeId} {
      allow read, write: if false;
    }
    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if trustedServer() && validCreate(uid);
      allow update: if trustedServer() && validUpdate(uid);
      allow delete: if trustedServer() && resource.data.ownerUid == uid;
    }
    match /users/{uid}/operations/{operationId} {
      allow read: if owns(uid);
      allow create: if trustedServer()
        && (validGenericOperation(uid, operationId)
          || validWateringOperation(uid, operationId));
      allow update, delete: if false;
    }
    match /users/{uid}/{collection}/{documentId} {
      allow read: if approvedCollection(collection) && owns(uid);
      allow create: if ownerWritable(collection) && !(collection == 'consents' && documentId == 'location') && owns(uid) && validCreate(uid) && validOwnerEntity(collection);
      allow update: if ownerWritable(collection) && !(collection == 'consents' && documentId == 'location') && owns(uid) && validUpdate(uid) && validOwnerEntity(collection);
      allow create: if collection == 'consents' && documentId == 'location' && trustedServer() && validCreate(uid) && validOwnerEntity(collection);
      allow update: if collection == 'consents' && documentId == 'location' && trustedServer() && validUpdate(uid) && validOwnerEntity(collection);
      allow create: if collection == 'placements' && trustedServer() && validPlacementMetadata(uid) && validOwnerEntity(collection);
      allow update: if collection == 'placements' && trustedServer() && validPlacementMetadata(uid) && validOwnerEntity(collection);
      allow create: if serverWritable(collection) && collection != 'placements' && trustedServer() && validCreate(uid)
        && (validServerEntity(collection) || (collection in ['wateringRecords', 'wateringSchedules', 'notificationSettings', 'notificationPlantSettings', 'weatherSettings', 'weatherPlantSettings', 'miniHomes', 'miniHomeStates'] && validOwnerEntity(collection)));
      allow update: if serverWritable(collection) && collection != 'notificationDeliveries' && collection != 'placements' && trustedServer() && validUpdate(uid)
        && (validServerEntity(collection) || (collection in ['wateringRecords', 'wateringSchedules', 'notificationSettings', 'notificationPlantSettings', 'weatherSettings', 'weatherPlantSettings', 'miniHomes', 'miniHomeStates'] && validOwnerEntity(collection)));
      allow delete: if ownerWritable(collection) && !(collection == 'consents' && documentId == 'location') && owns(uid) && resource.data.ownerUid == uid;
      allow delete: if collection == 'consents' && documentId == 'location' && trustedServer() && resource.data.ownerUid == uid;
      allow delete: if serverWritable(collection) && collection != 'notificationDeliveries' && trustedServer() && resource.data.ownerUid == uid;
    }
    match /users/{uid}/shareLinks/{shareId} {
      allow read, write: if false;
    }
    match /users/{uid}/miniHomeProjectionPointers/{pointerId} {
      allow read, write: if false;
    }
    match /users/{uid}/miniHomeProjections/{projectionId} {
      allow read, write: if false;
    }
    match /catalogProjectionPointers/{pointerId} {
      allow read, write: if false;
    }
    match /catalogProjections/{projectionId} {
      allow read, write: if false;
    }
    match /users/{uid}/weatherAlerts/{alertId} {
      allow read: if owns(uid);
      allow create, update: if trustedServer() && request.resource.data.ownerUid == uid;
      allow delete: if trustedServer() && resource.data.ownerUid == uid;
    }
    match /plantContents/{documentId} {
      allow read: if contentAdmin() || publicDocument();
      allow create, update: if contentAdmin() && validPublishedContent();
      allow delete: if contentAdmin();
    }
    match /riskContents/{documentId} {
      allow read: if contentAdmin() || publicDocument();
      allow create, update: if contentAdmin() && validPublishedContent();
      allow delete: if contentAdmin();
    }
    match /shopItems/{documentId} {
      allow read: if contentAdmin() || publicDocument();
      allow create: if contentAdmin()
        && validShopItem(documentId)
        && request.resource.data.revision == 1
        && request.resource.data.assetMediaRevision == 1;
      allow update: if contentAdmin()
        && validShopItem(documentId)
        && request.resource.data.revision == resource.data.revision + 1
        && validCatalogMediaVersionUpdate();
      allow delete: if contentAdmin();
    }
    // Admin SDK only. The public HTTP function is the sole recipient boundary.
    match /publicShares/{documentId} {
      allow read, write: if false;
    }
    match /auditLogs/{documentId} {
      allow read: if opsAdmin();
      allow create: if trustedServer();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
