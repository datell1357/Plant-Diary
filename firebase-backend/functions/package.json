{
  "name": "planterior-ios-account-deletion-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "pnpm run build && node --test 'lib/**/*.test.js'",
    "test:emulator": "pnpm run build && node --test --test-concurrency=1 'lib/**/*.emulator-spec.js'",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "verify:deploy": "pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2",
    "ky": "1.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.9.0"
}
